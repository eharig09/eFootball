filters:
  and:
    - 'file.inFolder("06 Sports Betting/Football/CFB/Observations")'
    - 'note.type == "cfb-observation"'
properties:
  note.observation:
    displayName: Observation
  note.direction:
    displayName: Direction
  note.team:
    displayName: Team
  note.category:
    displayName: Section
  note.carry:
    displayName: Carry forward
  note.review:
    displayName: Review / condition
views:
  - type: table
    name: Active and watch
    filters:
      or:
        - 'note.carry == "active"'
        - 'note.carry == "watch"'
    groupBy:
      property: note.team
      direction: ASC
    order:
      - note.observation
      - note.direction
      - note.category
      - note.carry
      - note.review
      - file.name
  - type: table
    name: All observations
    groupBy:
      property: note.team
      direction: ASC
    order:
      - note.observation
      - note.direction
      - note.category
      - note.carry
      - note.review
      - note.matchup
      - file.name
  - type: table
    name: Action triggers
    order:
      - note.observation
      - note.implication
      - note.applies_when
      - note.invalidated_by
      - note.next_check
      - note.resolution
      - note.team
      - note.matchup
  - type: table
    name: Predictions
    filters:
      and:
        - '!note.prediction.isEmpty()'
    order:
      - note.prediction
      - note.probability
      - note.prediction_result
      - note.actual
      - note.matchup
      - file.name
