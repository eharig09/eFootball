# Flask runtime
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
REGISTER_LEGACY_DASHBOARDS=1
# Render defaults this to 0 in application code to preserve memory. Set it to 1
# there only after moving to an instance with enough headroom for pandas/scikit.

# College Football Data (https://collegefootballdata.com)
CFBD_API_KEY=
CFB_DEFAULT_SEASON=2026
CFB_DATABASE_PATH=instance/cfb.sqlite3
CFBD_RAW_CACHE_PATH=instance/cfbd_raw
CFB_DISPLAY_TIMEZONE=America/New_York

# NFL / nflverse (no API key required)
NFL_DATABASE_PATH=instance/nfl.sqlite3
NFLVERSE_RAW_CACHE_PATH=instance/nflverse_raw
# Read-only source of NFL PFF exports; normalized rows are stored in nfl.sqlite3.
NFL_PFF_SOURCE_ROOT=C:\Users\ehari\Desktop\scouting_report
# Authenticates the Render Cron trigger; use the same long random value on both services.
CFB_REFRESH_TOKEN=
CFB_REFRESH_URL=
CFB_REFRESH_TIMEZONE=America/New_York
CFB_REFRESH_HOURS=6,12,18,23
# Optional. A newly-degraded, non-self-healing refresh segment POSTs a one-line
# {"text": ...} summary here once (Slack/Discord incoming-webhook shape).
CFB_ALERT_WEBHOOK=
# How long writers wait for a concurrent SQLite transaction on the live service.
CFB_SQLITE_BUSY_TIMEOUT_MS=60000

# Legacy social integrations
BLUESKY_USERNAME=
BLUESKY_PASSWORD=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sports-news-aggregator/1.0
# Either name works; YOUTUBE_API_KEY takes precedence.
YOUTUBE_API_KEY=

# Legacy Reds integrations
ATHLETIC_COOKIES=
REDS_SEASON_MODE=auto

# --- Secondary structured sources ---
# SportsDataverse (ESPN FPI, rosters, box scores) and Open-Meteo (kickoff
# weather) need no credentials. They are rate-limited and cached on disk.
#
# Optional: a commercial odds provider. The application works without it and
# already reads betting lines from CFBD, so leave this blank unless a paid plan
# is genuinely wanted.
ODDS_API_KEY=
